# Africa's Talking (sandbox)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SHORTCODE=
# AWS / Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# DynamoDB table used by DynamoStore in production
DYNAMO_TABLE_NAME=
# Webhook verification
WEBHOOK_SECRET=
# National Weather Service API requires a User-Agent with contact info
NWS_USER_AGENT="GhostLineKit (contact@example.com)"
# Phantom Handset server
# Bind address (default 127.0.0.1). A non-loopback HOST requires HANDSET_ACCESS_TOKEN.
HOST=127.0.0.1
# Port for the standalone handset server (default 8787)
PORT=8787
# Bearer token required for POST requests when HOST is not loopback (set your own; never commit it)
HANDSET_ACCESS_TOKEN=
# If set, CORS headers are added for exactly this origin
HANDSET_ALLOWED_ORIGIN=
# scripted (default, offline keyword stand-in) or bedrock (also needs BEDROCK_MODEL_ID)
HANDSET_LLM=scripted
# memory (default) or dynamo (also needs DYNAMO_TABLE_NAME)
HANDSET_STORE=memory
# on (default) or off to turn trace collection off
HANDSET_TRACE=on
